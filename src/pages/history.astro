---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Riwayat Pemesanan | KGYK">
  <!-- Main Section -->
  <main class="pt-12 pb-20 bg-lightbg min-h-[85vh] font-sans">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      
      <!-- Back Button & Brand Header Row -->
      <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <a href="/" class="inline-flex items-center gap-2.5 text-slate-600 hover:text-primary transition-all font-bold bg-white px-5 py-3 rounded-2xl shadow-soft border border-slate-100/60 max-w-max hover:shadow-md">
          <i class="ph ph-arrow-left text-lg font-bold text-primary"></i>
          <span>Kembali ke Beranda</span>
        </a>

        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-accent text-navy flex items-center justify-center font-black text-sm">K</span>
          <span class="text-xl font-black text-navy tracking-tight">KGYK <span class="text-primary font-bold">Rental</span></span>
        </div>
      </div>
      
      <!-- Logged Out State -->
      <div id="history-logged-out" class="bg-white rounded-3xl p-8 md:p-12 text-center shadow-soft border border-slate-100/60 max-w-md mx-auto">
        <div class="w-20 h-20 bg-slate-50 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-6">
          <i class="ph ph-lock text-4xl"></i>
        </div>
        <h3 class="text-2xl font-bold text-navy mb-3">Akses Terkunci</h3>
        <p class="text-slate-500 text-sm mb-8">Silakan masuk atau daftar akun terlebih dahulu untuk melihat riwayat pemesanan sewa mobil Anda.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <button id="history-login-btn" class="px-6 py-3 bg-primary hover:bg-blue-700 text-white font-bold rounded-xl text-sm transition-all shadow-md cursor-pointer">
            Masuk Akun
          </button>
          <button id="history-register-btn" class="px-6 py-3 border border-slate-200 text-slate-700 hover:bg-slate-50 font-bold rounded-xl text-sm transition-all cursor-pointer">
            Daftar Baru
          </button>
        </div>
      </div>

      <!-- Logged In State (Dashboard) -->
      <div id="history-logged-in" class="hidden">
        <div class="bg-white rounded-3xl p-8 lg:p-10 shadow-soft border border-slate-100/60">
          <!-- Header Area -->
          <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
            <div>
              <h3 class="text-2xl font-bold text-navy">Riwayat Pemesanan</h3>
              <p class="text-slate-500 text-sm">Kelola status, jadwal penyewaan, dan kelengkapan kendaraan Anda.</p>
            </div>
            
            <!-- Admin Simulator Mode Toggle -->
            <div class="flex items-center gap-3 bg-slate-100 border border-slate-200/50 rounded-2xl px-4 py-2 text-slate-700">
              <span class="text-xs font-bold flex items-center gap-1.5 text-navy">
                <i class="ph ph-shield-check text-base text-primary"></i>
                Simulasi Mode Admin
              </span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="adminModeToggle" class="sr-only peer" />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
              </label>
            </div>
          </div>

          <!-- Cards Grid Container -->
          <div id="booking-cards-container" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Dynamically Rendered Booking Cards -->
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- Modal Detail Struk (Inline Popup) -->
  <div id="historyReceiptModal" class="fixed inset-0 z-[100] hidden items-center justify-center">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-navy/60 backdrop-blur-sm transition-opacity" id="historyReceiptModalBackdrop"></div>

    <!-- Modal Content -->
    <div class="bg-white rounded-3xl max-w-lg w-full mx-4 relative z-10 transform scale-95 opacity-0 transition-all duration-300 shadow-2xl flex flex-col max-h-[92vh]" id="historyReceiptModalContent">
      
      <!-- Non-printable top bar -->
      <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between bg-slate-50 rounded-t-3xl print:hidden">
        <span class="text-sm font-extrabold text-slate-800">Detail Struk Reservasi</span>
        <button id="closeHistoryReceiptModalBtn" class="w-8 h-8 rounded-full hover:bg-slate-200 text-slate-400 hover:text-slate-600 flex items-center justify-center transition-colors cursor-pointer">
          <i class="ph ph-x text-lg"></i>
        </button>
      </div>

      <!-- Printable Receipt Content -->
      <div id="historyReceiptModalPrintArea" class="p-4 sm:p-6 overflow-y-auto print:overflow-visible print:p-4">
        <!-- Dynamic content will be injected here -->
      </div>

      <!-- Action Buttons (non-printable) -->
      <div class="px-6 pb-5 pt-2 flex flex-col gap-3 print:hidden">
        <div class="flex gap-3">
          <button id="printHistoryReceiptBtn" class="flex-1 py-3 px-4 bg-primary hover:bg-blue-700 text-white font-bold rounded-xl transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg cursor-pointer text-sm">
            <i class="ph ph-printer text-lg"></i>
            Cetak Struk
          </button>
          <button id="downloadHistoryReceiptBtn" class="flex-1 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg cursor-pointer text-sm">
            <i class="ph ph-download text-lg"></i>
            Unduh Gambar
          </button>
        </div>
        <button id="closeHistoryReceiptModalBtn2" class="w-full py-3 px-4 border border-slate-200 hover:bg-slate-50 text-slate-600 font-bold rounded-xl transition-all cursor-pointer text-sm">Tutup</button>
      </div>
    </div>
  </div>

  <style>
    @media print {
      body > *:not(#historyReceiptModal) {
        display: none !important;
      }
      #historyReceiptModal {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: white !important;
      }
      #historyReceiptModalContent {
        box-shadow: none !important;
        border: none !important;
        max-width: 100% !important;
        width: 100% !important;
        max-height: none !important;
        height: auto !important;
      }
      #historyReceiptModalContent > *:not(#historyReceiptModalPrintArea) {
        display: none !important;
      }
      #historyReceiptModalPrintArea {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
      }
    }
  </style>

</Layout>

<script>
  import html2canvas from 'html2canvas-pro';
  import { cars } from '../data/cars';

  document.addEventListener("DOMContentLoaded", () => {
    const loggedOutPanel = document.getElementById("history-logged-out");
    const loggedInPanel = document.getElementById("history-logged-in");
    
    const bookingCardsContainer = document.getElementById("booking-cards-container");
    const adminToggle = document.getElementById("adminModeToggle") as HTMLInputElement | null;
    
    const loginBtn = document.getElementById("history-login-btn");
    const registerBtn = document.getElementById("history-register-btn");

    if (!loggedOutPanel || !loggedInPanel || !bookingCardsContainer) return;

    // Login Modal Triggers
    loginBtn?.addEventListener("click", () => {
      if ((window as any).openLoginModal) (window as any).openLoginModal();
    });

    registerBtn?.addEventListener("click", () => {
      if ((window as any).openRegisterModal) (window as any).openRegisterModal();
    });

    const formatRupiah = (number: number) => {
      return new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
        minimumFractionDigits: 0
      }).format(number);
    };

    const formatDate = (dateStr: string) => {
      return new Date(dateStr).toLocaleDateString("id-ID", { day: 'numeric', month: 'short', year: 'numeric' });
    };

    // Modal elements for receipt inline viewer
    const historyReceiptModal = document.getElementById("historyReceiptModal");
    const historyReceiptModalContent = document.getElementById("historyReceiptModalContent");
    const historyReceiptModalBackdrop = document.getElementById("historyReceiptModalBackdrop");
    const historyReceiptModalPrintArea = document.getElementById("historyReceiptModalPrintArea");
    const closeHistoryReceiptModalBtn = document.getElementById("closeHistoryReceiptModalBtn");
    const closeHistoryReceiptModalBtn2 = document.getElementById("closeHistoryReceiptModalBtn2");
    const printHistoryReceiptBtn = document.getElementById("printHistoryReceiptBtn");
    const downloadHistoryReceiptBtn = document.getElementById("downloadHistoryReceiptBtn");

    let activeBooking: any = null;

    const openReceiptModal = (b: any) => {
      activeBooking = b;
      if (!historyReceiptModal || !historyReceiptModalPrintArea || !historyReceiptModalContent) return;

      const deadline = formatDate(b.endDate) + ', 16:00 WIB';
      const hasLateFee = b.lateFee && b.lateFee > 0;
      const isPaid = b.paymentStatus === 'Lunas';

      historyReceiptModalPrintArea.innerHTML = `
        <!-- Receipt Header -->
        <div class="text-center border-b-2 border-dashed border-slate-200 pb-3 mb-3">
          <div class="flex items-center justify-center gap-2 mb-1">
            <span class="w-6 h-6 rounded bg-primary text-white flex items-center justify-center font-black text-xs font-mono">K</span>
            <span class="font-extrabold text-sm text-navy tracking-tight">KGYK RENTAL MOBIL</span>
          </div>
          <p class="text-[9px] text-slate-400 font-medium leading-relaxed font-sans">
            Jl. Pandega Marga, Caturtunggal, Kec. Depok, Sleman, DIY 55281<br/>
            Telp/WA: +62 812 3456 7890 • Email: cs@kgyk.com
          </p>
        </div>

        <!-- Receipt Title -->
        <div class="text-center mb-3">
          <h3 class="text-sm font-extrabold text-navy tracking-wider uppercase">${isPaid ? (hasLateFee ? 'STRUK PENGEMBALIAN' : 'STRUK PEMBAYARAN') : 'STRUK PEMESANAN'}</h3>
          <p class="text-[9px] text-slate-400 font-semibold mt-0.5">${isPaid ? 'Bukti transaksi sewa kendaraan' : 'Tunjukkan struk ini kepada petugas saat pengambilan kendaraan'}</p>
        </div>

        <!-- Booking Code -->
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-3 mb-3 flex items-center justify-between">
          <div>
            <span class="text-[9px] text-slate-400 font-bold block uppercase">Kode Booking</span>
            <span class="text-md font-extrabold text-primary font-mono tracking-widest">${b.bookingCode || '-'}</span>
          </div>
          <div class="text-right">
            <span class="text-[9px] text-slate-400 font-bold block uppercase">Tanggal Cetak</span>
            <span class="text-[10px] font-bold text-slate-600">${new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          </div>
        </div>

        <!-- Customer Info -->
        <div class="mb-3 space-y-1.5 font-sans">
          <h5 class="text-[9px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-1">Data Penyewa</h5>
          <div class="grid grid-cols-2 gap-x-4 gap-y-1">
            <div>
              <span class="text-[8px] text-slate-400 font-bold block">NAMA</span>
              <span class="text-[10px] font-bold text-slate-700">${b.userName}</span>
            </div>
            <div>
              <span class="text-[8px] text-slate-400 font-bold block">EMAIL</span>
              <span class="text-[10px] font-semibold text-slate-600">${b.userEmail}</span>
            </div>
          </div>
        </div>

        <!-- Vehicle & Rental Details -->
        <div class="mb-3 space-y-1.5 font-sans">
          <h5 class="text-[9px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-1">Detail Sewa Kendaraan</h5>
          <div class="grid grid-cols-2 gap-x-4 gap-y-1">
            <div>
              <span class="text-[8px] text-slate-400 font-bold block">KENDARAAN</span>
              <span class="text-[10px] font-bold text-slate-700">${b.carName}</span>
            </div>
            <div>
              <span class="text-[8px] text-slate-400 font-bold block">LAYANAN</span>
              <span class="text-[10px] font-semibold text-slate-600">${b.serviceType}</span>
            </div>
            <div>
              <span class="text-[8px] text-slate-400 font-bold block">TANGGAL MULAI</span>
              <span class="text-[10px] font-bold text-slate-700">${formatDate(b.startDate)}</span>
            </div>
            <div>
              <span class="text-[8px] text-slate-400 font-bold block">TANGGAL SELESAI</span>
              <span class="text-[10px] font-bold text-slate-700">${formatDate(b.endDate)}</span>
            </div>
            <div>
              <span class="text-[8px] text-slate-400 font-bold block">DURASI</span>
              <span class="text-[10px] font-bold text-slate-700">${b.duration} Hari</span>
            </div>
            <div>
              <span class="text-[8px] text-slate-400 font-bold block">BATAS KEMBALI</span>
              <span class="text-[10px] font-bold text-slate-700">${deadline}</span>
            </div>
            <div class="col-span-2">
              <span class="text-[8px] text-slate-400 font-bold block">LOKASI AMBIL</span>
              <span class="text-[10px] font-semibold text-slate-600">${b.pickupLocation}</span>
            </div>
            <div class="col-span-2">
              <span class="text-[8px] text-slate-400 font-bold block">LOKASI KEMBALI</span>
              <span class="text-[10px] font-semibold text-slate-600">${b.dropoffLocation}</span>
            </div>
          </div>
        </div>

        <!-- Cost -->
        <div class="border-t-2 border-dashed border-slate-200 pt-3 mb-3 space-y-1 font-sans">
          <div class="flex justify-between items-center text-[10px]">
            <span class="text-slate-500 font-medium">Biaya Sewa</span>
            <span class="font-bold text-slate-700">${formatRupiah(b.totalPrice)}</span>
          </div>
          ${hasLateFee ? `
            <div class="bg-red-50 border border-red-100 rounded-lg p-2 my-1.5 font-sans">
              <div class="flex justify-between items-center text-[10px]">
                <span class="text-red-600 font-bold font-sans">Denda Keterlambatan (${b.lateFeeHours} jam)</span>
                <span class="text-red-600 font-bold font-sans">+${formatRupiah(b.lateFee)}</span>
              </div>
            </div>
          ` : ''}
          <div class="flex justify-between items-center text-[12px] font-extrabold text-navy border-t border-slate-100 pt-2 mt-1">
            <span>TOTAL AKHIR</span>
            <span>${formatRupiah(b.grandTotal || b.totalPrice)}</span>
          </div>
        </div>

        <!-- Payment Status Badge -->
        <div class="text-center mb-3">
          <span class="inline-flex items-center gap-1.5 px-4 py-1.5 ${isPaid ? 'bg-green-50 text-green-700 border-green-200' : 'bg-amber-50 text-amber-700 border-amber-200'} border rounded-full text-[10px] font-extrabold uppercase tracking-wider font-sans">
            ${isPaid ? 'LUNAS' : 'BELUM BAYAR'}
          </span>
        </div>

        <!-- Footer -->
        <div class="border-t-2 border-dashed border-slate-200 pt-3 text-center space-y-1 font-sans">
          <p class="text-[8px] text-slate-400 font-medium leading-relaxed">
            ${isPaid ? 'Bukti transaksi sewa kendaraan ini sah dan resmi dari pihak KGYK Rental.' : 'Struk ini wajib ditunjukkan kepada petugas saat pengambilan kendaraan. Pembayaran dilakukan di tempat.'}
          </p>
          <p class="text-[8px] text-slate-400 font-semibold leading-relaxed">
            Keterlambatan pengembalian melewati jam 16:00 WIB pada tanggal akhir sewa<br/>
            dikenakan denda 10% tarif harian per jam. Lebih dari 5 jam = 1 hari penuh.
          </p>
          <p class="text-[7px] text-slate-300 font-semibold pt-2">
            Dicetak pada: ${new Date().toLocaleString("id-ID")} • KGYK Rental Mobil Yogyakarta
          </p>
        </div>
      `;

      // Show modal with animation
      historyReceiptModal.classList.remove("hidden");
      historyReceiptModal.classList.add("flex");
      setTimeout(() => {
        historyReceiptModalContent.classList.remove("scale-95", "opacity-0");
        historyReceiptModalContent.classList.add("scale-100", "opacity-100");
      }, 10);
    };

    const closeReceiptModal = () => {
      if (!historyReceiptModal || !historyReceiptModalContent) return;
      historyReceiptModalContent.classList.remove("scale-100", "opacity-100");
      historyReceiptModalContent.classList.add("scale-95", "opacity-0");
      setTimeout(() => {
        historyReceiptModal.classList.add("hidden");
        historyReceiptModal.classList.remove("flex");
        activeBooking = null;
      }, 300);
    };

    // Close button & backdrop events
    closeHistoryReceiptModalBtn?.addEventListener("click", closeReceiptModal);
    closeHistoryReceiptModalBtn2?.addEventListener("click", closeReceiptModal);
    historyReceiptModalBackdrop?.addEventListener("click", closeReceiptModal);

    // Print receipt
    printHistoryReceiptBtn?.addEventListener("click", () => {
      window.print();
    });

    // Download receipt image
    downloadHistoryReceiptBtn?.addEventListener("click", () => {
      if (!historyReceiptModalPrintArea || !activeBooking) return;

      const filename = `Struk-${activeBooking.bookingCode || "Booking"}.png`;

      if (html2canvas) {
        // Create an off-screen clone container to isolate rendering from parent transforms/transitions
        const clone = historyReceiptModalPrintArea.cloneNode(true) as HTMLElement;
        clone.style.position = "absolute";
        clone.style.left = "-9999px";
        clone.style.top = "0";
        clone.style.width = "375px"; // Fixed standard receipt width
        clone.style.height = "auto";
        clone.style.background = "#ffffff";
        clone.style.padding = "24px";
        clone.style.boxSizing = "border-box";
        
        document.body.appendChild(clone);

        // Wait a tiny bit for the clone to mount and compute styles
        setTimeout(() => {
          html2canvas(clone, {
            scale: 2,
            useCORS: true,
            backgroundColor: '#ffffff',
            logging: false,
            width: 375
          }).then((canvas: HTMLCanvasElement) => {
            canvas.toBlob(function(blob) {
              // Clean up clone
              document.body.removeChild(clone);
              
              if (!blob) {
                alert("Gagal memproses gambar struk.");
                return;
              }
              const url = URL.createObjectURL(blob);
              const link = document.createElement('a');
              link.download = filename;
              link.href = url;
              document.body.appendChild(link);
              link.click();
              document.body.removeChild(link);
              setTimeout(() => URL.revokeObjectURL(url), 100);
            }, 'image/png');
          }).catch((err: any) => {
            console.error("html2canvas error:", err);
            // Clean up clone
            if (document.body.contains(clone)) {
              document.body.removeChild(clone);
            }
            alert("Gagal mengunduh gambar: " + (err.message || err.toString()));
          });
        }, 50);
      } else {
        alert("Gagal memuat modul gambar. Silakan gunakan tombol Cetak.");
      }
    });

    const renderBookings = () => {
      const currentUser = JSON.parse(localStorage.getItem("kgyk_current_user") || "null");
      if (!currentUser) return;

      const isAdmin = adminToggle ? adminToggle.checked : false;
      const bookings = JSON.parse(localStorage.getItem("kgyk_bookings") || "[]");
      
      const displayedBookings = isAdmin 
        ? bookings 
        : bookings.filter((b: any) => b.userEmail === currentUser.email);

      bookingCardsContainer.innerHTML = "";

      if (displayedBookings.length === 0) {
        bookingCardsContainer.innerHTML = `
          <div class="col-span-full text-center py-16 px-4 bg-slate-50/50 rounded-2xl border border-dashed border-slate-200">
            <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
              <i class="ph ph-calendar-blank text-3xl"></i>
            </div>
            <h4 class="text-navy font-bold text-lg mb-1">Belum Ada Pemesanan</h4>
            <p class="text-slate-500 text-sm max-w-sm mx-auto mb-6">Anda belum memesan kendaraan apapun. Pilih armada favorit Anda dan nikmati perjalanan menyenangkan.</p>
            <a href="/" class="px-5 py-2.5 bg-primary hover:bg-blue-700 text-white font-bold rounded-xl text-xs transition-all shadow-sm">
              Cari Mobil Sekarang
            </a>
          </div>
        `;
        return;
      }

      displayedBookings.forEach((b: any) => {
        let statusClass = "bg-amber-50 text-amber-700 border-amber-200/60";
        let statusIcon = "ph-clock";
        if (b.status === "Disetujui") {
          statusClass = "bg-green-50 text-green-700 border-green-200/60";
          statusIcon = "ph-check-circle";
        }
        if (b.status === "Ditolak") {
          statusClass = "bg-red-50 text-red-700 border-red-200/60";
          statusIcon = "ph-x-circle";
        }
        if (b.status === "Dalam Penyewaan") {
          statusClass = "bg-blue-50 text-blue-700 border-blue-200/60";
          statusIcon = "ph-car";
        }
        if (b.status === "Selesai") {
          statusClass = "bg-slate-100 text-slate-700 border-slate-200/60";
          statusIcon = "ph-circle-wavy-check";
        }

        const formattedStart = formatDate(b.startDate);
        const formattedEnd = formatDate(b.endDate);
        const hasLateFee = b.lateFee && b.lateFee > 0;

        const adminControls = isAdmin ? `
          <div class="flex items-center gap-2">
            ${b.status === "Menunggu Verifikasi" ? `
              <button data-approve-id="${b.id}" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-sm hover:shadow cursor-pointer">Setujui</button>
              <button data-reject-id="${b.id}" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-sm hover:shadow cursor-pointer">Tolak</button>
            ` : b.status === "Disetujui" ? `
              <button data-release-id="${b.id}" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-sm hover:shadow cursor-pointer flex items-center gap-1">
                <i class="ph ph-hand-coins"></i> Lepas & Bayar
              </button>
            ` : b.status === "Dalam Penyewaan" ? `
              <button data-return-id="${b.id}" class="bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-sm hover:shadow cursor-pointer flex items-center gap-1">
                <i class="ph ph-flag-chequered"></i> Kembalikan
              </button>
            ` : `<span class="text-[10px] text-slate-400 font-bold bg-slate-50 border border-slate-100 rounded-lg px-2 py-1">${b.status}</span>`}
          </div>
        ` : "";

        // Find vehicle details
        const car = cars.find(c => c.name === b.carName);
        const carImg = car ? car.img : "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=600&q=80";
        const carType = car ? car.type : "Armada";

        const card = `
          <div class="bg-white rounded-3xl p-6 shadow-soft border border-slate-100 hover:border-primary/20 hover:shadow-md transition-all duration-300 flex flex-col justify-between">
            <div>
              <!-- Card Top Heading -->
              <div class="flex items-center justify-between gap-4 mb-4 pb-3 border-b border-slate-100">
                <div class="flex items-center gap-1.5">
                  <span class="px-2 py-0.5 bg-blue-50 rounded-md text-[10px] font-extrabold text-blue-600 tracking-wider font-mono">${b.bookingCode || '#' + b.id.toString().slice(-6)}</span>
                  ${isAdmin ? `<span class="text-[10px] text-primary font-bold">Admin View</span>` : ""}
                </div>
                <span class="px-2.5 py-1 inline-flex items-center gap-1 text-[11px] font-bold leading-5 rounded-full border ${statusClass}">
                  <i class="ph-fill ${statusIcon}"></i>
                  ${b.status}
                </span>
              </div>

              <!-- Main Card Body -->
              <div class="flex flex-col sm:flex-row gap-5 mb-5">
                <!-- Vehicle Preview -->
                <div class="w-full sm:w-2/5 aspect-[4/3] rounded-2xl overflow-hidden border border-slate-100 bg-slate-50 shrink-0">
                  <img src="${carImg}" alt="${b.carName}" class="w-full h-full object-cover">
                </div>

                <!-- Specs and Notes -->
                <div class="flex-1 space-y-2">
                  <div class="flex items-start justify-between gap-2">
                    <h4 class="text-base font-bold text-navy">${b.carName}</h4>
                    <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-semibold">${carType}</span>
                  </div>
                  
                  ${isAdmin ? `
                    <div class="text-[11px] text-slate-500 font-medium">
                      Pemesan: <span class="text-slate-800 font-semibold">${b.userName} (${b.userEmail})</span>
                    </div>
                  ` : ""}

                  <!-- Details Specs Grid -->
                  <div class="grid grid-cols-1 gap-1.5 text-[11px] text-slate-600">
                    <div class="flex items-center gap-1.5">
                      <i class="ph ph-calendar-blank text-slate-400 text-sm"></i>
                      <span class="font-semibold text-slate-700">${formattedStart} - ${formattedEnd}</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <i class="ph ph-timer text-slate-400 text-sm"></i>
                      <span>Durasi: <span class="font-bold text-slate-700">${b.duration} Hari</span> (${b.serviceType})</span>
                    </div>
                    <div class="flex items-start gap-1.5">
                      <i class="ph ph-map-pin text-slate-400 text-sm mt-0.5"></i>
                      <span>Ambil: <span class="font-medium text-slate-700">${b.pickupLocation}</span></span>
                    </div>
                    <div class="flex items-start gap-1.5">
                      <i class="ph ph-map-pin-line text-slate-400 text-sm mt-0.5"></i>
                      <span>Kembali: <span class="font-medium text-slate-700">${b.dropoffLocation}</span></span>
                    </div>
                  </div>

                  <!-- Payment Status -->
                  ${b.paymentStatus === 'Lunas' ? `
                    <div class="flex items-center gap-1 text-[10px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-100 rounded-lg px-2 py-1 w-max">
                      <i class="ph-fill ph-check-circle"></i> Lunas
                    </div>
                  ` : `
                    <div class="flex items-center gap-1 text-[10px] font-bold text-amber-600 bg-amber-50 border border-amber-100 rounded-lg px-2 py-1 w-max">
                      <i class="ph-fill ph-clock"></i> Belum Bayar
                    </div>
                  `}

                  <!-- Late Fee Info -->
                  ${hasLateFee ? `
                    <div class="bg-red-50 border border-red-100 rounded-lg p-2 text-[10px]">
                      <span class="text-red-600 font-bold">Denda Keterlambatan: ${formatRupiah(b.lateFee)} (${b.lateFeeHours} jam)</span>
                    </div>
                  ` : ''}
                </div>
              </div>
            </div>

            <!-- Card Bottom (Cost & Actions) -->
            <div class="pt-4 border-t border-slate-100 flex flex-row items-center justify-between gap-4 mt-auto">
              <div>
                <span class="text-[10px] text-slate-400 font-bold block uppercase tracking-wider">Total Biaya</span>
                <span class="text-lg font-extrabold text-navy">${formatRupiah(b.grandTotal || b.totalPrice)}</span>
                ${hasLateFee ? `<span class="text-[9px] text-red-500 font-bold block">Termasuk denda ${formatRupiah(b.lateFee)}</span>` : ''}
              </div>

              <div class="flex items-center gap-2">
                ${adminControls}
                <button data-receipt-id="${b.id}" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-600 text-[10px] font-bold rounded-xl transition-all cursor-pointer flex items-center gap-1 border border-slate-200">
                  <i class="ph ph-receipt"></i> Struk
                </button>
                ${b.status === "Selesai" ? `
                  <a href="/?car=${encodeURIComponent(b.carName)}#reservasi" class="px-3.5 py-2 bg-primary hover:bg-blue-700 text-white text-[11px] font-bold rounded-xl transition-all shadow-sm hover:shadow text-center flex items-center gap-1.5 cursor-pointer">
                    <i class="ph ph-arrow-counter-clockwise font-bold"></i>
                    Pesan Kembali
                  </a>
                ` : ""}
              </div>
            </div>
          </div>
        `;
        bookingCardsContainer.insertAdjacentHTML("beforeend", card);
      });

      // Bind receipt buttons
      bookingCardsContainer.querySelectorAll("[data-receipt-id]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = parseInt(btn.getAttribute("data-receipt-id") || "0");
          const booking = displayedBookings.find((b: any) => b.id === id);
          if (booking) openReceiptModal(booking);
        });
      });

      // Bind admin action buttons
      if (isAdmin) {
        bookingCardsContainer.querySelectorAll("[data-approve-id]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = parseInt(btn.getAttribute("data-approve-id") || "0");
            updateBookingStatus(id, "Disetujui");
          });
        });
        
        bookingCardsContainer.querySelectorAll("[data-reject-id]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = parseInt(btn.getAttribute("data-reject-id") || "0");
            updateBookingStatus(id, "Ditolak");
          });
        });

        // Release & Pay
        bookingCardsContainer.querySelectorAll("[data-release-id]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = parseInt(btn.getAttribute("data-release-id") || "0");
            const bookings = JSON.parse(localStorage.getItem("kgyk_bookings") || "[]");
            const index = bookings.findIndex((b: any) => b.id === id);
            if (index !== -1) {
              const now = new Date().toISOString();
              bookings[index].status = "Dalam Penyewaan";
              bookings[index].paymentStatus = "Lunas";
              bookings[index].paidAt = now;
              bookings[index].releasedAt = now;
              localStorage.setItem("kgyk_bookings", JSON.stringify(bookings));
              renderBookings();
              openReceiptModal(bookings[index]);
              if ((window as any).showToast) {
                (window as any).showToast(`Kendaraan telah dilepas & pembayaran diterima!`, 'success');
              }
            }
          });
        });

        // Return
        bookingCardsContainer.querySelectorAll("[data-return-id]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = parseInt(btn.getAttribute("data-return-id") || "0");
            const bookings = JSON.parse(localStorage.getItem("kgyk_bookings") || "[]");
            const index = bookings.findIndex((b: any) => b.id === id);
            if (index !== -1) {
              const b = bookings[index];
              const now = new Date();
              const deadline = new Date(b.endDate);
              deadline.setHours(16, 0, 0, 0);

              let lateHours = 0;
              let lateFee = 0;

              if (now > deadline) {
                const diffMs = now.getTime() - deadline.getTime();
                lateHours = Math.ceil(diffMs / (1000 * 60 * 60));
                const car = cars.find(c => c.name === b.carName);
                const pricePerDay = car ? car.price : 0;
                const feePerHour = Math.round(pricePerDay * 10 / 100);
                if (lateHours > 5) {
                  lateFee = pricePerDay;
                } else {
                  lateFee = feePerHour * lateHours;
                }
              }

              bookings[index].status = "Selesai";
              bookings[index].returnedAt = now.toISOString();
              bookings[index].lateFeeHours = lateHours;
              bookings[index].lateFee = lateFee;
              bookings[index].grandTotal = b.totalPrice + lateFee;

              localStorage.setItem("kgyk_bookings", JSON.stringify(bookings));
              renderBookings();
              openReceiptModal(bookings[index]);
              if ((window as any).showToast) {
                const msg = lateHours > 0
                  ? `Mobil dikembalikan dengan denda ${formatRupiah(lateFee)} (${lateHours} jam terlambat)`
                  : `Mobil dikembalikan tepat waktu! Transaksi selesai.`;
                (window as any).showToast(msg, lateHours > 0 ? 'warning' : 'success');
              }
            }
          });
        });
      }
    };

    const updateBookingStatus = (id: number, status: "Disetujui" | "Ditolak" | "Selesai") => {
      const bookings = JSON.parse(localStorage.getItem("kgyk_bookings") || "[]");
      const index = bookings.findIndex((b: any) => b.id === id);
      if (index !== -1) {
        bookings[index].status = status;
        localStorage.setItem("kgyk_bookings", JSON.stringify(bookings));
        renderBookings();
        if ((window as any).showToast) {
          (window as any).showToast(`Pesanan ${bookings[index].bookingCode || '#' + id.toString().slice(-6)} berhasil ${status.toLowerCase()}!`, 'success');
        }
      }
    };

    adminToggle?.addEventListener("change", renderBookings);

    const updateUIState = () => {
      const currentUser = JSON.parse(localStorage.getItem("kgyk_current_user") || "null");
      if (currentUser) {
        loggedOutPanel.classList.add("hidden");
        loggedInPanel.classList.remove("hidden");
        renderBookings();
      } else {
        loggedOutPanel.classList.remove("hidden");
        loggedInPanel.classList.add("hidden");
      }
    };

    window.addEventListener("auth-changed", updateUIState);
    updateUIState();
  });
</script>
