---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CarDetailModal from '../components/CarDetailModal.astro';
import SuccessModal from '../components/SuccessModal.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { cars } from '../data/cars';

const title = "Katalog Armada Mobil Lengkap | KGYK Rental";
const description = "Temukan berbagai pilihan armada mobil terbaik dan terawat di KGYK Rental dengan harga transparan dan pemesanan mudah.";
---

<Layout title={title} description={description}>
  <!-- Navigation Header -->
  <Header />

  <!-- Main Section -->
  <main class="min-h-screen bg-slate-50 font-sans pt-0">
    
    <!-- Hero Banner Header -->
    <section class="relative bg-gradient-to-r from-navy via-slate-900 to-navy text-white pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden">
      <!-- Background pattern overlay -->
      <div class="absolute inset-0 opacity-10 bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:24px_24px]"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-primary rounded-full filter blur-3xl opacity-20 -translate-y-1/2 translate-x-1/4"></div>
      
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs md:text-sm text-slate-300 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-accent transition-colors flex items-center gap-1">
            <i class="ph ph-house"></i> Beranda
          </a>
          <i class="ph ph-caret-right text-slate-500"></i>
          <span class="text-white font-semibold">Katalog Mobil</span>
        </nav>
        
        <div class="max-w-3xl">
          <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4 animate-fade-in">
            Katalog Armada <span class="text-accent">KGYK</span>
          </h1>
          <p class="text-base md:text-lg text-slate-300 leading-relaxed mb-0">
            Jelajahi berbagai pilihan mobil berkualitas yang siap menemani perjalanan Anda. Bersih, terawat, dan selalu siap dalam performa terbaik.
          </p>
        </div>
      </div>
    </section>

    <!-- Search, Filter & Availability Check Section -->
    <section class="container mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
      <div class="bg-white rounded-3xl p-6 shadow-xl border border-slate-100/80">
        <div class="space-y-6">
          
          <!-- Baris 1: Pencarian, Status Pill, dan Sorting -->
          <div class="flex flex-col lg:flex-row gap-4 items-stretch lg:items-center justify-between pb-6 border-b border-slate-100">
            
            <!-- Pencarian -->
            <div class="relative flex-grow max-w-md">
              <label for="searchInput" class="sr-only">Cari Mobil</label>
              <input 
                type="text" 
                id="searchInput" 
                placeholder="Cari nama mobil..." 
                class="w-full pl-12 pr-4 py-3.5 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all text-sm text-slate-800 placeholder-slate-400"
              />
              <i class="ph ph-magnifying-glass absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-400 text-xl"></i>
            </div>

            <!-- Sorting -->
            <div class="flex items-center gap-2 shrink-0 justify-between sm:justify-end">
              <span class="text-xs text-slate-500 font-semibold whitespace-nowrap"><i class="ph ph-funnel text-sm"></i> Urutkan:</span>
              <select id="sortSelect" class="px-3 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all bg-slate-50 focus:bg-white text-slate-700 text-xs font-bold cursor-pointer min-w-[150px]">
                <option value="recommended">Rekomendasi</option>
                <option value="price-asc">Harga Terendah</option>
                <option value="price-desc">Harga Tertinggi</option>
                <option value="capacity-desc">Kapasitas Terbesar</option>
              </select>
            </div>

          </div>

          <!-- Baris 1.5: Filter Tipe Mobil -->
          <div class="flex flex-wrap gap-2 pb-6 border-b border-slate-100 justify-start">
            <button class="catalog-filter-btn active px-4 py-2 rounded-full text-xs font-bold bg-primary text-white shadow-md transition-all cursor-pointer" data-filter="all">Semua Tipe</button>
            <button class="catalog-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all cursor-pointer" data-filter="mpv">MPV</button>
            <button class="catalog-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all cursor-pointer" data-filter="suv">SUV</button>
            <button class="catalog-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all cursor-pointer" data-filter="city car">City Car</button>
            <button class="catalog-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all cursor-pointer" data-filter="van">Van</button>
          </div>

          <!-- Baris 2: Cek Ketersediaan Berdasarkan Tanggal -->
          <div class="bg-blue-50/50 rounded-2xl p-5 border border-blue-100/50">
            <h3 class="text-sm font-bold text-navy mb-3 flex items-center gap-2">
              <i class="ph ph-calendar-check text-primary text-lg"></i>
              Cek Ketersediaan Tanggal Sewa
            </h3>
            <div class="flex flex-col lg:flex-row gap-4 items-stretch lg:items-end">
              <div class="grid grid-cols-2 gap-3 flex-grow">
                <div>
                  <label for="checkStartDate" class="block text-[10px] sm:text-xs font-semibold text-slate-600 mb-1.5">Mulai Sewa</label>
                  <input 
                    type="date" 
                    id="checkStartDate" 
                    class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all bg-white text-slate-700 text-xs"
                  />
                </div>
                <div>
                  <label for="checkEndDate" class="block text-[10px] sm:text-xs font-semibold text-slate-600 mb-1.5">Selesai Sewa</label>
                  <input 
                    type="date" 
                    id="checkEndDate" 
                    class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all bg-white text-slate-700 text-xs"
                  />
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2 w-full lg:w-auto shrink-0">
                <button id="btnCheckAvailability" class="w-full lg:w-auto px-4 py-3 bg-primary hover:bg-blue-700 text-white text-[11px] sm:text-xs font-bold rounded-xl transition-all shadow-md flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap">
                  <i class="ph ph-magnifying-glass-plus text-base"></i> Cari Mobil Ready
                </button>
                <button id="btnResetAvailability" class="w-full lg:w-auto px-4 py-3 border border-slate-200 text-slate-500 hover:bg-slate-50 text-[11px] sm:text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap" title="Reset tanggal">
                  <i class="ph ph-arrow-counter-clockwise text-base"></i> Reset
                </button>
              </div>
            </div>

            <!-- Pesan info status pengecekan tanggal -->
            <div id="availabilityMsg" class="hidden text-xs font-bold text-slate-600 mt-4 p-3 bg-blue-100/60 rounded-xl border border-blue-200/40 flex items-center gap-2 animate-fade-in">
              <i class="ph ph-info text-base text-primary"></i>
              <span id="availabilityMsgText"></span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Catalog Vehicles Grid -->
    <section class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div id="catalogGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <!-- Will be populated by JS -->
      </div>

      <!-- No match found -->
      <div id="noCarFound" class="hidden text-center py-24 bg-white rounded-3xl border border-slate-100 shadow-sm">
        <div class="w-20 h-20 bg-slate-50 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="ph ph-car text-4xl"></i>
        </div>
        <h3 class="text-xl font-bold text-navy mb-2">Mobil Tidak Ditemukan</h3>
        <p class="text-slate-500 text-sm max-w-xs mx-auto">Silakan sesuaikan filter tanggal atau ubah kata kunci pencarian Anda.</p>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <Footer />

  <!-- Modals & Overlays -->
  <CarDetailModal />
  <SuccessModal />

  <!-- WhatsApp Button -->
  <WhatsAppButton />
</Layout>

<style>
  /* Layout is fully responsive without custom class overrides */
</style>

<script>
  import { cars } from '../data/cars';

  document.addEventListener("DOMContentLoaded", () => {
    const catalogGrid = document.getElementById("catalogGrid");
    const noCarFound = document.getElementById("noCarFound");
    const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
    const sortSelect = document.getElementById("sortSelect") as HTMLSelectElement | null;
    const catalogFilterBtns = document.querySelectorAll(".catalog-filter-btn");
    let currentCategoryFilter = 'all';
    
    // Date availability checker elements
    const checkStartDate = document.getElementById("checkStartDate") as HTMLInputElement | null;
    const checkEndDate = document.getElementById("checkEndDate") as HTMLInputElement | null;
    const btnCheck = document.getElementById("btnCheckAvailability");
    const btnReset = document.getElementById("btnResetAvailability");
    const availabilityMsg = document.getElementById("availabilityMsg");
    const availabilityMsgText = document.getElementById("availabilityMsgText");

    if (!catalogGrid || !noCarFound) return;

    // Set minimal date input to today
    const todayStr = new Date().toISOString().split('T')[0];
    if (checkStartDate) checkStartDate.min = todayStr;
    if (checkEndDate) checkEndDate.min = todayStr;

    if (checkStartDate && checkEndDate) {
      checkStartDate.addEventListener("change", () => {
        checkEndDate.min = checkStartDate.value;
        if (checkEndDate.value && checkEndDate.value < checkStartDate.value) {
          checkEndDate.value = checkStartDate.value;
        }
      });
    }

    const formatRupiah = (number: number) => {
      return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(number);
    };

    const renderCars = (carArray: typeof cars) => {
      catalogGrid.innerHTML = "";
      if (carArray.length === 0) {
        noCarFound.classList.remove("hidden");
      } else {
        noCarFound.classList.add("hidden");
        carArray.forEach((car, index) => {
          const statusBadge = car.status
            ? `<span class="px-2.5 py-0.5 bg-green-50 text-green-700 text-[10px] font-bold rounded-full border border-green-200">Tersedia</span>`
            : `<span class="px-2.5 py-0.5 bg-red-50 text-red-700 text-[10px] font-bold rounded-full border border-red-200">Penuh</span>`;

          const btnClass = car.status 
            ? `bg-primary hover:bg-blue-700 text-white cursor-pointer` 
            : `bg-slate-200 text-slate-400 cursor-not-allowed`;
          const btnAction = car.status ? `data-book-car="${car.name}"` : `disabled`;

          const html = `
            <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col group" data-aos="fade-up" data-aos-delay="${(index % 4) * 50}">
              <!-- Cover Image -->
              <div class="relative h-48 overflow-hidden cursor-pointer" data-detail-id="${car.id}">
                <img src="${car.img}" alt="${car.name}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                <div class="absolute inset-0 bg-navy/35 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center z-10">
                  <span class="bg-white text-navy px-4 py-2 rounded-2xl font-bold text-xs shadow-lg transform translate-y-3 group-hover:translate-y-0 transition-all duration-300">Detail Mobil</span>
                </div>
                <div class="absolute top-3.5 right-3.5 z-20">
                  ${statusBadge}
                </div>
                <div class="absolute bottom-3.5 left-3.5 z-20">
                  <span class="px-2.5 py-0.5 bg-white/90 backdrop-blur-sm text-navy text-[10px] font-bold rounded-md shadow-sm">${car.type}</span>
                </div>
              </div>

              <!-- Details Content -->
              <div class="p-5 flex-grow flex flex-col justify-between">
                <div>
                  <h3 class="text-base font-bold text-navy mb-3 cursor-pointer hover:text-primary transition-colors truncate" data-detail-id="${car.id}">${car.name}</h3>
                  
                  <div class="grid grid-cols-2 gap-y-2 mb-4 border-b border-slate-50 pb-4">
                    <div class="flex items-center gap-1.5 text-xs text-slate-600">
                      <i class="ph text-primary ph-users text-base"></i> ${car.capacity}
                    </div>
                    <div class="flex items-center gap-1.5 text-xs text-slate-600">
                      <i class="ph text-primary ph-gas-pump text-base"></i> Bensin
                    </div>
                    <div class="flex items-center gap-1.5 text-xs text-slate-600 col-span-2">
                      <i class="ph text-primary ph-steering-wheel text-base"></i> ${car.trans}
                    </div>
                  </div>
                </div>

                <div class="mt-auto">
                  <div class="flex items-baseline justify-between mb-4">
                    <div>
                      <p class="text-[10px] text-slate-400">Harga rental</p>
                      <p class="text-base font-extrabold text-navy">${formatRupiah(car.price)}<span class="text-[10px] font-normal text-slate-400">/hari</span></p>
                    </div>
                  </div>

                  <div class="flex gap-2">
                    <button data-detail-id="${car.id}" class="p-2.5 rounded-xl border border-slate-200 text-slate-500 hover:bg-slate-50 hover:text-primary transition-all cursor-pointer" title="Lihat Detail">
                      <i class="ph ph-info text-base"></i>
                    </button>
                    <button ${btnAction} class="${btnClass} flex-grow py-2.5 rounded-xl text-xs font-bold transition-all text-center">
                      Booking
                    </button>
                  </div>
                </div>
              </div>
            </div>
          `;
          catalogGrid.insertAdjacentHTML("beforeend", html);
        });

        // Event listener for opening detail modal
        catalogGrid.querySelectorAll("[data-detail-id]").forEach(el => {
          el.addEventListener("click", () => {
            const id = parseInt(el.getAttribute("data-detail-id") || "0");
            if (id && (window as any).openCarDetail) {
              (window as any).openCarDetail(id);
            }
          });
        });

        // Event listener for booking
        catalogGrid.querySelectorAll("[data-book-car]").forEach(el => {
          el.addEventListener("click", () => {
            const carName = el.getAttribute("data-book-car");
            if (carName && (window as any).bookCar) {
              (window as any).bookCar(carName);
            }
          });
        });
      }
    };

    const filterAndSort = (triggeredDateCheck = false) => {
      const searchVal = searchInput ? searchInput.value.toLowerCase().trim() : "";
      const sortBy = sortSelect ? sortSelect.value : "recommended";

      let result = [...cars];

      // 1. Filter by search query
      if (searchVal) {
        result = result.filter(car => car.name.toLowerCase().includes(searchVal));
      }

      // 2. Filter by category
      if (currentCategoryFilter !== 'all') {
        result = result.filter(car => car.category === currentCategoryFilter);
      }

      // 3. Filter by date-range availability (if dates are provided and user explicitly checked)
      const hasDates = checkStartDate && checkEndDate && checkStartDate.value && checkEndDate.value;
      if (hasDates && triggeredDateCheck) {
        const start = new Date(checkStartDate.value);
        const end = new Date(checkEndDate.value);

        if (end < start) {
          (window as any).showToast("Tanggal selesai tidak boleh sebelum tanggal mulai.", "error");
          return;
        }

        const bookings = JSON.parse(localStorage.getItem("kgyk_bookings") || "[]");

        // Filter out cars with conflicting bookings
        result = result.filter(car => {
          // Mobil yang status statisnya false otomatis tidak tersedia
          if (!car.status) return false;

          // Cek overlap booking
          const isBooked = bookings.some((b: any) => {
            if (b.carName === car.name && b.status !== "Ditolak") {
              const bStart = new Date(b.startDate);
              const bEnd = new Date(b.endDate);
              // Overlap check formula: (StartA <= EndB) and (EndA >= StartB)
              return (start <= bEnd && end >= bStart);
            }
            return false;
          });

          return !isBooked;
        });

        // Show feedback message
        if (availabilityMsg && availabilityMsgText) {
          const formattedStart = start.toLocaleDateString("id-ID", { day: 'numeric', month: 'short', year: 'numeric' });
          const formattedEnd = end.toLocaleDateString("id-ID", { day: 'numeric', month: 'short', year: 'numeric' });
          availabilityMsgText.innerText = `Menampilkan ${result.length} mobil yang tersedia untuk periode sewa: ${formattedStart} s/d ${formattedEnd}`;
          availabilityMsg.classList.remove("hidden");
        }
      } else {
        // Hide availability message if date filter is not active
        if (availabilityMsg) {
          availabilityMsg.classList.add("hidden");
        }
      }

      // 4. Sort cars
      if (sortBy === "price-asc") {
        result.sort((a, b) => a.price - b.price);
      } else if (sortBy === "price-desc") {
        result.sort((a, b) => b.price - a.price);
      } else if (sortBy === "capacity-desc") {
        const getCapVal = (c: string) => parseInt(c.replace(/\D/g, '')) || 0;
        result.sort((a, b) => getCapVal(b.capacity) - getCapVal(a.capacity));
      } else if (sortBy === "recommended") {
        result.sort((a, b) => a.id - b.id);
      }

      renderCars(result);
    };

    // Initial render
    filterAndSort();

    // Category filter buttons event listener
    catalogFilterBtns.forEach(btn => {
      btn.addEventListener("click", (e) => {
        catalogFilterBtns.forEach(b => {
          b.classList.remove("bg-primary", "text-white", "shadow-md", "active");
          b.classList.add("bg-slate-100", "text-slate-600");
        });
        const target = e.currentTarget as HTMLButtonElement;
        target.classList.remove("bg-slate-100", "text-slate-600");
        target.classList.add("bg-primary", "text-white", "shadow-md", "active");

        currentCategoryFilter = target.getAttribute("data-filter") || 'all';
        const hasDates = !!(checkStartDate && checkEndDate && checkStartDate.value && checkEndDate.value);
        filterAndSort(hasDates);
      });
    });

    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const hasDates = !!(checkStartDate && checkEndDate && checkStartDate.value && checkEndDate.value);
        filterAndSort(hasDates);
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener("change", () => {
        const hasDates = !!(checkStartDate && checkEndDate && checkStartDate.value && checkEndDate.value);
        filterAndSort(hasDates);
      });
    }

    // Trigger date search check
    btnCheck?.addEventListener("click", () => {
      if (checkStartDate && checkEndDate && (!checkStartDate.value || !checkEndDate.value)) {
        (window as any).showToast("Silakan lengkapi tanggal mulai dan selesai sewa terlebih dahulu.", "warning");
        return;
      }
      filterAndSort(true);
    });

    // Reset date search check
    btnReset?.addEventListener("click", () => {
      if (checkStartDate) checkStartDate.value = "";
      if (checkEndDate) checkEndDate.value = "";
      filterAndSort(false);
    });

    // Global booking mapping
    (window as any).bookCar = (carName: string) => {
      const currentUser = JSON.parse(localStorage.getItem("kgyk_current_user") || "null");
      if (!currentUser) {
        if ((window as any).openLoginModal) {
          (window as any).openLoginModal();
        }
        return;
      }
      
      // Redirect to homepage with query param and date values if specified
      let queryStr = `?car=${encodeURIComponent(carName)}`;
      if (checkStartDate && checkEndDate && checkStartDate.value && checkEndDate.value) {
        queryStr += `&start=${checkStartDate.value}&end=${checkEndDate.value}`;
      }
      window.location.href = `/${queryStr}#reservasi`;
    };
  });
</script>
