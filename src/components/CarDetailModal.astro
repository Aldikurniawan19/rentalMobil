---
---
<!-- Modal Detail Mobil -->
<div id="carDetailModal" class="fixed inset-0 z-[110] hidden items-center justify-center p-4 sm:p-6">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-navy/70 backdrop-blur-sm transition-opacity" id="detailModalBackdrop"></div>

  <!-- Modal Content -->
  <div class="bg-white rounded-3xl w-full max-w-4xl relative z-10 transform scale-95 opacity-0 transition-all duration-300 shadow-2xl flex flex-col md:flex-row overflow-hidden max-h-[90vh]" id="carDetailContent">
    <!-- Close Btn -->
    <button id="detailModalCloseBtn" class="absolute top-4 right-4 w-10 h-10 bg-white/50 backdrop-blur hover:bg-slate-200 rounded-full flex items-center justify-center text-slate-800 transition-colors z-20 shadow-sm">
      <i class="ph ph-x text-xl font-bold"></i>
    </button>

    <!-- Image Section -->
    <div class="w-full md:w-1/2 h-64 md:h-auto relative bg-slate-100 flex-shrink-0">
      <img id="detailModalImg" src="" alt="Car Image" class="w-full h-full object-cover" />
      <div class="absolute bottom-4 left-4">
        <span id="detailModalType" class="px-4 py-1.5 bg-white/90 backdrop-blur-sm text-navy text-sm font-bold rounded-full shadow-sm"></span>
      </div>
    </div>

    <!-- Content Section -->
    <div class="w-full md:w-1/2 p-6 md:p-10 flex flex-col overflow-y-auto">
      <h3 id="detailModalTitle" class="text-2xl md:text-3xl font-bold text-navy mb-2"></h3>

      <div class="flex flex-wrap items-center gap-4 text-sm text-slate-600 mb-6 pb-6 border-b border-slate-100">
        <div class="flex items-center gap-2"><i class="ph text-primary ph-users text-lg"></i> <span id="detailModalCapacity"></span></div>
        <div class="flex items-center gap-2"><i class="ph text-primary ph-gas-pump text-lg"></i> Bensin</div>
        <div class="flex items-center gap-2"><i class="ph text-primary ph-steering-wheel text-lg"></i> <span id="detailModalTrans"></span></div>
      </div>

      <div class="flex-grow">
        <h4 class="font-bold text-navy mb-2 text-lg">Deskripsi Kendaraan</h4>
        <p id="detailModalDesc" class="text-slate-600 text-sm leading-relaxed mb-6"></p>

        <h4 class="font-bold text-navy mb-2 text-lg">Fasilitas Termasuk</h4>
        <ul class="space-y-2 text-sm text-slate-600 mb-8">
          <li class="flex items-center gap-2"><i class="ph-fill ph-check-circle text-green-500 text-lg"></i> Asuransi All Risk (Bebas cemas)</li>
          <li class="flex items-center gap-2"><i class="ph-fill ph-check-circle text-green-500 text-lg"></i> Perawatan Berkala Standar Dealer</li>
          <li class="flex items-center gap-2"><i class="ph-fill ph-check-circle text-green-500 text-lg"></i> Dukungan Bantuan Darurat 24/7</li>
        </ul>
      </div>

      <div class="mt-auto pt-6 border-t border-slate-100">
        <p class="text-sm text-slate-500 mb-1">Harga Sewa</p>
        <p class="text-3xl font-bold text-navy mb-4"><span id="detailModalPrice"></span> <span class="text-sm font-normal text-slate-500">/hari</span></p>

        <button id="detailModalBookBtn" class="w-full py-4 bg-primary hover:bg-blue-700 text-white font-bold rounded-xl transition-colors shadow-lg hover:shadow-xl hover:-translate-y-0.5 transform">Booking Mobil Ini</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { cars } from '../data/cars';

  const formatRupiah = (number: number) => {
    return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(number);
  };

  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("carDetailModal");
    const content = document.getElementById("carDetailContent");
    const backdrop = document.getElementById("detailModalBackdrop");
    const closeBtn = document.getElementById("detailModalCloseBtn");
    
    const detailModalImg = document.getElementById("detailModalImg") as HTMLImageElement | null;
    const detailModalTitle = document.getElementById("detailModalTitle");
    const detailModalType = document.getElementById("detailModalType");
    const detailModalCapacity = document.getElementById("detailModalCapacity");
    const detailModalTrans = document.getElementById("detailModalTrans");
    const detailModalDesc = document.getElementById("detailModalDesc");
    const detailModalPrice = document.getElementById("detailModalPrice");
    const bookBtn = document.getElementById("detailModalBookBtn") as HTMLButtonElement | null;

    if (!modal || !content || !backdrop || !closeBtn) return;

    const closeCarDetail = () => {
      content.classList.remove("scale-100", "opacity-100");
      content.classList.add("scale-95", "opacity-0");
      setTimeout(() => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }, 300);
    };

    closeBtn.addEventListener("click", closeCarDetail);
    backdrop.addEventListener("click", closeCarDetail);

    // Make global functions
    (window as any).openCarDetail = (id: number) => {
      const car = cars.find((c) => c.id === id);
      if (!car) return;

      if (detailModalImg) detailModalImg.src = car.img;
      if (detailModalTitle) detailModalTitle.innerText = car.name;
      if (detailModalType) detailModalType.innerText = car.type;
      if (detailModalCapacity) detailModalCapacity.innerText = car.capacity;
      if (detailModalTrans) detailModalTrans.innerText = car.trans;
      if (detailModalDesc) detailModalDesc.innerText = car.description;
      if (detailModalPrice) detailModalPrice.innerText = formatRupiah(car.price);

      if (bookBtn) {
        if (car.status) {
          bookBtn.disabled = false;
          bookBtn.className = "w-full py-4 bg-primary hover:bg-blue-700 text-white font-bold rounded-xl transition-colors shadow-lg hover:shadow-xl hover:-translate-y-0.5 transform mt-2";
          bookBtn.innerText = "Booking Mobil Ini";
          bookBtn.onclick = () => {
            closeCarDetail();
            // Wait for modal closing animation before scrolling
            setTimeout(() => {
              if ((window as any).bookCar) {
                (window as any).bookCar(car.name);
              }
            }, 300);
          };
        } else {
          bookBtn.disabled = true;
          bookBtn.className = "w-full py-4 bg-slate-200 text-slate-500 font-bold rounded-xl cursor-not-allowed mt-2";
          bookBtn.innerText = "Mobil Tidak Tersedia";
          bookBtn.onclick = null;
        }
      }

      modal.classList.remove("hidden");
      modal.classList.add("flex");
      setTimeout(() => {
        content.classList.remove("scale-95", "opacity-0");
        content.classList.add("scale-100", "opacity-100");
      }, 10);
    };

    (window as any).closeCarDetail = closeCarDetail;
  });
</script>
