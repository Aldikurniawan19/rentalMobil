---
<!-- Promo Section -->
<section class="py-12 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-3xl p-8 md:p-12 shadow-2xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8" data-aos="zoom-in">
      <!-- BG Elements -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full mix-blend-overlay filter blur-xl transform translate-x-1/2 -translate-y-1/2"></div>

      <div class="relative z-10 md:w-2/3 text-center md:text-left text-white">
        <span class="inline-block px-3 py-1 bg-accent text-navy text-xs font-bold rounded-full mb-4 uppercase tracking-wider">Promo Terbatas</span>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Diskon 15% Untuk Sewa Mingguan!</h2>
        <p class="text-blue-100 text-lg">Dapatkan harga lebih hemat untuk rencana liburan keluarga panjang Anda. Berlaku hingga akhir bulan ini.</p>
      </div>

      <div class="relative z-10 md:w-1/3 text-center md:text-right">
        <a href="#reservasi" class="inline-block px-8 py-4 bg-white text-primary font-bold rounded-full shadow-lg hover:bg-slate-50 transition-all transform hover:scale-105"> Klaim Promo Sekarang </a>
      </div>
    </div>
  </div>
</section>
