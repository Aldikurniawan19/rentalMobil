---
---
<!-- Car Catalog Section -->
<section id="mobil" class="py-20 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-6">
      <div class="max-w-xl" data-aos="fade-right">
        <h4 class="text-primary font-bold tracking-wider uppercase text-sm mb-2">Katalog Armada</h4>
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-0">Pilih Mobil Sesuai Kebutuhan Anda</h2>
      </div>

      <!-- Button Lihat Selengkapnya di Kanan Atas -->
      <div class="shrink-0" data-aos="fade-left">
        <a href="/katalog" class="inline-flex items-center gap-2 px-6 py-3.5 bg-primary hover:bg-blue-700 text-white text-sm font-bold rounded-2xl shadow-md hover:shadow-lg transition-all duration-300">
          <span>Lihat Selengkapnya</span>
          <i class="ph ph-arrow-right font-bold"></i>
        </a>
      </div>
    </div>

    <!-- Car Grid -->
    <div id="carGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Cars will be populated here via JavaScript -->
    </div>

    <!-- Empty State -->
    <div id="noCarFound" class="hidden text-center py-20">
      <i class="ph ph-car text-6xl text-slate-300 mb-4"></i>
      <h3 class="text-xl font-bold text-navy mb-2">Mobil tidak ditemukan</h3>
      <p class="text-slate-500">Silakan coba pencarian dengan kata kunci lain.</p>
    </div>
  </div>
</section>

<script>
  import { cars } from '../../data/cars';

  document.addEventListener("DOMContentLoaded", () => {
    const carGrid = document.getElementById("carGrid");
    const noCarFound = document.getElementById("noCarFound");

    if (!carGrid || !noCarFound) return;

    const formatRupiah = (number: number) => {
      return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(number);
    };

    const renderCars = (carArray: typeof cars) => {
      carGrid.innerHTML = "";
      if (carArray.length === 0) {
        noCarFound.classList.remove("hidden");
      } else {
        noCarFound.classList.add("hidden");
        carArray.forEach((car, index) => {
          const statusBadge = car.status
            ? `<span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-bold rounded-full">Tersedia</span>`
            : `<span class="px-3 py-1 bg-red-100 text-red-700 text-xs font-bold rounded-full">Tidak Tersedia</span>`;

          const btnClass = car.status ? `bg-primary hover:bg-blue-700 text-white cursor-pointer` : `bg-slate-300 text-slate-500 cursor-not-allowed`;
          const btnAction = car.status ? `data-book-car="${car.name}"` : `disabled`;

          const html = `
            <div class="bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 group flex flex-col" data-aos="fade-up" data-aos-delay="${(index % 3) * 100}">
                <div class="relative h-56 overflow-hidden cursor-pointer" data-detail-id="${car.id}">
                    <img src="${car.img}" alt="${car.name}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                    <div class="absolute inset-0 bg-navy/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center z-10">
                        <span class="bg-white text-primary px-4 py-2 rounded-full font-bold text-sm shadow-lg transform translate-y-4 group-hover:translate-y-0 transition-all duration-300">Lihat Detail</span>
                    </div>
                    <div class="absolute top-4 right-4 z-20">
                        ${statusBadge}
                    </div>
                    <div class="absolute bottom-4 left-4 z-20">
                        <span class="px-3 py-1 bg-white/90 backdrop-blur-sm text-navy text-xs font-bold rounded-full shadow-sm">${car.type}</span>
                    </div>
                </div>
                <div class="p-6 flex-grow flex flex-col">
                    <h3 class="text-xl font-bold text-navy mb-4 cursor-pointer hover:text-primary transition-colors" data-detail-id="${car.id}">${car.name}</h3>
                    <div class="grid grid-cols-2 gap-y-3 mb-6">
                        <div class="flex items-center gap-2 text-sm text-slate-600">
                            <i class="ph text-primary ph-users"></i> ${car.capacity}
                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-600">
                            <i class="ph text-primary ph-gas-pump"></i> Bensin
                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-600">
                            <i class="ph text-primary ph-steering-wheel"></i> ${car.trans}
                        </div>
                    </div>
                    <div class="pt-4 mt-auto border-t border-slate-100 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-500">Mulai dari</p>
                            <p class="text-lg font-bold text-navy">${formatRupiah(car.price)} <span class="text-sm font-normal text-slate-500">/hari</span></p>
                        </div>
                        <div class="flex gap-2">
                            <button data-detail-id="${car.id}" class="px-3 py-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-primary text-sm font-semibold transition-colors" title="Lihat Detail">
                                <i class="ph ph-info text-lg"></i>
                            </button>
                            <button ${btnAction} class="${btnClass} px-4 py-2 rounded-xl text-sm font-semibold transition-colors">
                                Booking
                            </button>
                        </div>
                    </div>
                </div>
            </div>
          `;
          carGrid.insertAdjacentHTML("beforeend", html);
        });

        // Re-bind events to dynamically created elements
        carGrid.querySelectorAll("[data-detail-id]").forEach(el => {
          el.addEventListener("click", () => {
            const id = parseInt(el.getAttribute("data-detail-id") || "0");
            if (id && (window as any).openCarDetail) {
              (window as any).openCarDetail(id);
            }
          });
        });

        carGrid.querySelectorAll("[data-book-car]").forEach(el => {
          el.addEventListener("click", () => {
            const carName = el.getAttribute("data-book-car");
            if (carName && (window as any).bookCar) {
              (window as any).bookCar(carName);
            }
          });
        });
      }
    };

    // Initial render - only show 3 cars on landing page
    renderCars(cars.slice(0, 3));

    // Global bookCar mapping
    (window as any).bookCar = (carName: string) => {
      const currentUser = JSON.parse(localStorage.getItem("kgyk_current_user") || "null");
      if (!currentUser) {
        if ((window as any).openLoginModal) {
          (window as any).openLoginModal();
        }
        return;
      }

      const formSection = document.getElementById("reservasi");
      if (formSection) {
        formSection.scrollIntoView({ behavior: "smooth" });
      }
      const carSelect = document.getElementById("formCar") as HTMLSelectElement | null;
      if (carSelect) {
        for (let i = 0; i < carSelect.options.length; i++) {
          if (carSelect.options[i].text.includes(carName) || carSelect.options[i].value === carName) {
            carSelect.selectedIndex = i;
            carSelect.dispatchEvent(new Event("change"));
            break;
          }
        }
      }
    };
  });
</script>
