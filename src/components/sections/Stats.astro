---
import { cars } from '../../data/cars';
---
<!-- Availability Checker Form -->
<section class="relative -mt-10 mx-4 sm:mx-6 lg:mx-8 z-20">
  <div class="container mx-auto max-w-6xl bg-white p-6 md:p-8 rounded-2xl shadow-soft border border-slate-100">
    <h3 class="text-lg font-bold text-navy mb-4 flex items-center gap-2">
      <i class="ph ph-calendar-search text-primary text-xl"></i>
      Cek Ketersediaan Mobil
    </h3>
    
    <form id="availabilityForm" class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
      <!-- Date Start -->
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Mulai Sewa</label>
        <input type="date" id="checkDateStart" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-slate-700 text-sm" />
      </div>
      
      <!-- Date End -->
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Selesai Sewa</label>
        <input type="date" id="checkDateEnd" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-slate-700 text-sm" />
      </div>
      
      <!-- Car Choice -->
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Pilih Mobil</label>
        <select id="checkCar" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-slate-700 text-sm">
          <option value="all">Semua Mobil</option>
          {cars.map(c => (
            <option value={c.name}>{c.name}</option>
          ))}
        </select>
      </div>

      <!-- Pickup Location -->
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Lokasi Pengambilan</label>
        <input type="text" id="checkPickup" required placeholder="Contoh: Bandara" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-slate-800 text-sm" />
      </div>

      <!-- Submit Button -->
      <div>
        <button type="submit" class="w-full py-3 bg-primary hover:bg-blue-700 text-white font-bold rounded-xl transition-all shadow-md text-sm hover:shadow-lg cursor-pointer">
          Cek Ketersediaan
        </button>
      </div>
    </form>

    <!-- Results Panel -->
    <div id="checkResults" class="hidden mt-6 pt-6 border-t border-slate-100 animate-fade-in">
      <div id="resultsContent"></div>
    </div>
  </div>
</section>

<script>
  import { cars } from '../../data/cars';

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("availabilityForm") as HTMLFormElement | null;
    const dateStart = document.getElementById("checkDateStart") as HTMLInputElement | null;
    const dateEnd = document.getElementById("checkDateEnd") as HTMLInputElement | null;
    const carSelect = document.getElementById("checkCar") as HTMLSelectElement | null;
    const pickupInput = document.getElementById("checkPickup") as HTMLInputElement | null;
    const resultsPanel = document.getElementById("checkResults");
    const resultsContent = document.getElementById("resultsContent");

    if (!form || !resultsPanel || !resultsContent) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      if (!dateStart || !dateEnd || !carSelect || !pickupInput) return;

      const start = new Date(dateStart.value);
      const end = new Date(dateEnd.value);

      if (end < start) {
        if ((window as any).showToast) {
          (window as any).showToast("Tanggal selesai tidak boleh sebelum tanggal mulai.", "error");
        } else {
          alert("Tanggal selesai tidak boleh sebelum tanggal mulai.");
        }
        return;
      }

      const selectedCarName = carSelect.value;
      const pickupLocation = pickupInput.value.trim();

      // Retrieve bookings
      const bookings = JSON.parse(localStorage.getItem("kgyk_bookings") || "[]");

      // Filter check scope
      const carsToCheck = selectedCarName === "all" 
        ? cars 
        : cars.filter(c => c.name === selectedCarName);

      // Conflict validation logic
      const availableCars = carsToCheck.filter(car => {
        const hasConflict = bookings.some((b: any) => {
          if (b.carName === car.name && b.status !== "Ditolak") {
            const existingStart = new Date(b.startDate);
            const existingEnd = new Date(b.endDate);
            // Overlap formula
            return (start <= existingEnd && end >= existingStart);
          }
          return false;
        });
        return !hasConflict;
      });

      resultsPanel.classList.remove("hidden");
      resultsContent.innerHTML = "";

      // Case 1: No cars available
      if (availableCars.length === 0) {
        resultsContent.innerHTML = `
          <div class="bg-red-50 border border-red-100 rounded-2xl p-5 text-center text-red-700">
            <i class="ph ph-warning-circle text-4xl block mb-2 text-red-500"></i>
            <p class="font-semibold text-sm">Mobil tidak tersedia pada jadwal tersebut. Silakan pilih tanggal lain.</p>
          </div>
        `;
        return;
      }

      // Case 2: Available cars listed
      let html = `
        <h4 class="text-sm font-bold text-navy mb-4 flex items-center gap-1.5">
          <i class="ph ph-check-circle text-green-500 text-lg"></i>
          Pilihan Mobil Tersedia pada Jadwal Anda:
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      `;

      availableCars.forEach((car) => {
        html += `
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50 p-4 border border-slate-100 rounded-2xl hover:border-slate-200 transition-colors">
            <div class="flex items-center gap-4 w-full sm:w-auto">
              <img src="${car.img}" alt="${car.name}" class="w-20 h-14 sm:w-24 sm:h-16 object-cover rounded-xl border border-slate-100 flex-shrink-0">
              <div class="flex-grow min-w-0">
                <h5 class="text-sm font-bold text-navy truncate">${car.name}</h5>
                <p class="text-xs text-slate-500 font-medium">${car.type} • ${car.trans}</p>
                <p class="text-xs font-bold text-primary mt-1">${new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(car.price)} /hari</p>
              </div>
            </div>
            <button data-order-car="${car.name}" class="w-full sm:w-auto bg-primary hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl text-xs shadow-sm hover:shadow-md transition-all cursor-pointer text-center whitespace-nowrap">
              Pesan Sekarang
            </button>
          </div>
        `;
      });

      html += `</div>`;
      resultsContent.innerHTML = html;

      // Bind dynamic Pesan Sekarang click triggers
      resultsContent.querySelectorAll("[data-order-car]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const carName = btn.getAttribute("data-order-car") || "";
          
          // Check authentication
          const currentUser = JSON.parse(localStorage.getItem("kgyk_current_user") || "null");
          if (!currentUser) {
            if ((window as any).showToast) {
              (window as any).showToast("Silakan login atau daftar akun terlebih dahulu untuk melakukan pemesanan.", "error");
            } else {
              alert("Silakan login atau daftar akun terlebih dahulu untuk melakukan pemesanan.");
            }
            if ((window as any).openLoginModal) {
              (window as any).openLoginModal();
            }
            return;
          }

          // Pre-fill fields in main Booking Form
          const formCar = document.getElementById("formCar") as HTMLSelectElement | null;
          const formDateStart = document.getElementById("formDateStart") as HTMLInputElement | null;
          const formDateEnd = document.getElementById("formDateEnd") as HTMLInputElement | null;
          const formPickup = document.getElementById("formPickup") as HTMLInputElement | null;
          const formDropoff = document.getElementById("formDropoff") as HTMLInputElement | null;

          if (formCar) {
            formCar.value = carName;
            formCar.dispatchEvent(new Event("change"));
          }
          if (formDateStart) {
            formDateStart.value = dateStart.value;
            formDateStart.dispatchEvent(new Event("change"));
          }
          if (formDateEnd) {
            formDateEnd.value = dateEnd.value;
            formDateEnd.dispatchEvent(new Event("change"));
          }
          if (formPickup) {
            formPickup.value = pickupLocation;
          }
          if (formDropoff) {
            formDropoff.value = pickupLocation;
          }

          // Scroll to Booking Form section
          const bookingSection = document.getElementById("reservasi");
          if (bookingSection) {
            bookingSection.scrollIntoView({ behavior: "smooth" });
          }
        });
      });
    });
  });
</script>
