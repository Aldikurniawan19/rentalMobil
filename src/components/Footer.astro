<!-- Footer -->
<footer class="bg-navy pt-20 pb-10 border-t border-slate-800 font-sans">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 mb-16">
      
      <!-- Brand & Socials Column -->
      <div class="md:col-span-2 lg:col-span-3">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-10 h-10 bg-accent rounded-xl flex items-center justify-center text-navy shadow-sm">
            <i class="ph ph-car-profile text-2xl"></i>
          </div>
          <span class="font-bold text-2xl tracking-tight text-white">KGYK<span class="text-accent">.</span></span>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Penyedia jasa rental mobil terpercaya untuk keperluan pribadi, wisata, maupun operasional perusahaan dengan harga terbaik dan pelayanan profesional di wilayah Jabodetabek.
        </p>
        <!-- Social Media Links -->
        <div class="flex items-center gap-3">
          <a href="#" class="w-9 h-9 rounded-full bg-slate-800/80 hover:bg-accent text-slate-400 hover:text-navy flex items-center justify-center transition-all duration-300 shadow-md transform hover:-translate-y-1">
            <i class="ph ph-instagram-logo text-lg"></i>
          </a>
          <a href="#" class="w-9 h-9 rounded-full bg-slate-800/80 hover:bg-accent text-slate-400 hover:text-navy flex items-center justify-center transition-all duration-300 shadow-md transform hover:-translate-y-1">
            <i class="ph ph-facebook-logo text-lg"></i>
          </a>
          <a href="#" class="w-9 h-9 rounded-full bg-slate-800/80 hover:bg-accent text-slate-400 hover:text-navy flex items-center justify-center transition-all duration-300 shadow-md transform hover:-translate-y-1">
            <i class="ph ph-youtube-logo text-lg"></i>
          </a>
          <a href="#" class="w-9 h-9 rounded-full bg-slate-800/80 hover:bg-accent text-slate-400 hover:text-navy flex items-center justify-center transition-all duration-300 shadow-md transform hover:-translate-y-1">
            <i class="ph ph-whatsapp-logo text-lg"></i>
          </a>
        </div>
      </div>

      <!-- Navigasi Column -->
      <div class="lg:col-span-2">
        <h4 class="text-white font-bold mb-6 relative after:content-[''] after:absolute after:bottom-[-8px] after:left-0 after:w-8 after:h-[2px] after:bg-accent">Navigasi</h4>
        <ul class="space-y-3">
          <li><a href="#home" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Beranda</a></li>
          <li><a href="#layanan" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Layanan Kami</a></li>
          <li><a href="#mobil" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Katalog Mobil</a></li>
          <li><a href="#keunggulan" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Keunggulan</a></li>
          <li><a href="#testimoni" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Testimoni</a></li>
        </ul>
      </div>

      <!-- Layanan Column -->
      <div class="lg:col-span-2">
        <h4 class="text-white font-bold mb-6 relative after:content-[''] after:absolute after:bottom-[-8px] after:left-0 after:w-8 after:h-[2px] after:bg-accent">Layanan</h4>
        <ul class="space-y-3">
          <li><a href="#layanan" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Rental Harian</a></li>
          <li><a href="#layanan" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Tour Wisata</a></li>
          <li><a href="#layanan" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Dengan Sopir</a></li>
          <li><a href="#layanan" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Jemput Bandara</a></li>
          <li><a href="#layanan" class="text-slate-400 hover:text-accent transition-colors text-sm flex items-center gap-1.5"><i class="ph ph-caret-right text-xs"></i> Mobil Pengantin</a></li>
        </ul>
      </div>

      <!-- Kontak Kami Column -->
      <div class="lg:col-span-2">
        <h4 class="text-white font-bold mb-6 relative after:content-[''] after:absolute after:bottom-[-8px] after:left-0 after:w-8 after:h-[2px] after:bg-accent">Hubungi Kami</h4>
        <ul class="space-y-3">
          <li class="text-slate-400 text-sm flex items-start gap-2.5">
            <i class="ph ph-map-pin text-accent text-lg mt-0.5 flex-shrink-0"></i>
            <span>Jl. Raya Monas No. 1, Jakarta Pusat, 10110</span>
          </li>
          <li class="text-slate-400 text-sm flex items-center gap-2.5">
            <i class="ph ph-phone text-accent text-lg flex-shrink-0"></i>
            <a href="tel:+6281234567890" class="hover:text-accent transition-colors">+62 812-3456-7890</a>
          </li>
          <li class="text-slate-400 text-sm flex items-center gap-2.5">
            <i class="ph ph-envelope text-accent text-lg flex-shrink-0"></i>
            <a href="mailto:info@kgyk.com" class="hover:text-accent transition-colors">info@kgyk.com</a>
          </li>
          <li class="text-slate-400 text-sm flex items-center gap-2.5">
            <i class="ph ph-clock text-accent text-lg flex-shrink-0"></i>
            <span>Setiap Hari (24 Jam)</span>
          </li>
        </ul>
      </div>

      <!-- Google Maps Embed Column -->
      <div class="lg:col-span-3">
        <h4 class="text-white font-bold mb-6 relative after:content-[''] after:absolute after:bottom-[-8px] after:left-0 after:w-8 after:h-[2px] after:bg-accent">Lokasi Kantor</h4>
        <div class="w-full h-44 rounded-2xl overflow-hidden border border-slate-800 shadow-lg group">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.6666666666665!2d106.8242!3d-6.1754!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f5d4e12e12e1%3A0x6b0a1d6a3f4e1f!2sMonumen%20Nasional!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid" 
            class="w-full h-full border-0 group-hover:scale-105 transition-transform duration-500" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
      
    </div>

    <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row items-center justify-between">
      <p class="text-slate-500 text-sm mb-4 md:mb-0">&copy; 2026 KGYK. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="text-slate-500 hover:text-accent text-sm transition-colors">Privacy Policy</a>
        <a href="#" class="text-slate-500 hover:text-accent text-sm transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
